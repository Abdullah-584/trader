# Copy this file to ".env" (it is git-ignored) and fill in ONLY what you use.
# The bot runs perfectly in paper mode with ALL of these left empty.
# Never hardcode secrets in config.yaml or code.

# --- Telegram alerts (optional; alerts.telegram: true in config.yaml to use) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Exchange API keys (optional; ONLY used by live mode, never by paper) ---
# Market data uses public endpoints and needs NO keys.
# If you ever go live: use a key with trading permission ONLY (withdrawals
# disabled) and IP-whitelist your machine.
BINANCE_API_KEY=
BINANCE_SECRET=
